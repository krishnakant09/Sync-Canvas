# SyncCanvas Environment Configuration

# Server Port (default: 1234)
PORT=1234

# Node Environment ('development' or 'production')
NODE_ENV=production

# Redis Cluster Connection URL (Optional - leave empty for standalone single-node mode)
# Example: redis://localhost:6379 or rediss://default:password@host:port
REDIS_URL=

# Directory to persist compacted CRDT binary snapshots
SNAPSHOT_DIR=./server/storage/snapshots
